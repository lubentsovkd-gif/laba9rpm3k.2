<Window x:Class="laba9rpm3k._2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:laba9rpm3k._2"
        mc:Ignorable="d"
        Title="Телефонная книга"
        Height="500" 
        Width="850"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- 
            Верхняя панель с меню навигации
            DockPanel.Dock="Top" закрепляет её вверху
        -->
        <StackPanel DockPanel.Dock="Top" 
                    Orientation="Horizontal" 
                    Background="#F0F0F0"
                    Margin="0,0,0,10">

            <Button Content="📞 Контакты" 
                    Command="{Binding ShowContactsCommand}"
                    Margin="5,8"
                    Padding="15,5"
                    MinWidth="100"/>

            <Button Content="ℹ️ О программе" 
                    Command="{Binding ShowAboutCommand}"
                    Margin="5,8"
                    Padding="15,5"
                    MinWidth="100"/>
        </StackPanel>

        <!-- 
            Основная область контента
            ContentControl автоматически отображает UserControl,
            соответствующий текущей ViewModel через DataTemplate
        -->
        <ContentControl Content="{Binding NavigationService.CurrentViewModel}" />
    </DockPanel>
</Window>