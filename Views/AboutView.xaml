<UserControl x:Class="laba9rpm3k._2.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid Background="White">
        <StackPanel Margin="30"
                    VerticalAlignment="Center">

            <TextBlock Text="{Binding AppName}"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="{Binding Authors}"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <Border Background="#F0F0F0"
                    Padding="20"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="О программе"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Телефонная книга с поддержкой ViewModel-First навигации"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Функции:"
                               FontWeight="Bold"
                               Margin="0,10,0,5"/>

                    <TextBlock Text="• Добавление контактов"
                               Margin="20,0,0,5"/>
                    <TextBlock Text="• Удаление контактов"
                               Margin="20,0,0,5"/>
                    <TextBlock Text="• Валидация номера телефона"
                               Margin="20,0,0,5"/>
                    <TextBlock Text="• ViewModel-First навигация"
                               Margin="20,0,0,5"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>