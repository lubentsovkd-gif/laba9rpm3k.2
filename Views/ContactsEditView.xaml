<UserControl x:Class="laba9rpm3k._2.Views.ContactsEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" 
                Background="#2C3E50" 
                Padding="20">
            <TextBlock Text="✏️ Редактирование контакта"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Основная форма редактирования -->
        <StackPanel Grid.Row="1" 
                    Margin="30" 
                    VerticalAlignment="Center">

            <!-- Поле для имени -->
            <TextBlock Text="Имя контакта"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#2C3E50"
                       Margin="0,0,0,5"/>

            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="16"
                     Padding="10"
                     Margin="0,0,0,20"
                     Background="White"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"/>

            <!-- Поле для номера телефона -->
            <TextBlock Text="Номер телефона"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#2C3E50"
                       Margin="0,0,0,5"/>

            <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="16"
                     Padding="10"
                     Margin="0,0,0,20"
                     Background="White"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"/>

            <!-- Подсказка о формате номера -->
            <TextBlock Text="Формат номера: +7-XXX-XXX-XX-XX"
                       FontSize="12"
                       Foreground="#7F8C8D"
                       Margin="0,-10,0,20"/>
        </StackPanel>

        <!-- Панель кнопок -->
        <Border Grid.Row="2" 
                Background="#ECF0F1" 
                Padding="15">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center">

                <Button Content="💾 Сохранить"
                        Command="{Binding SaveCommand}"
                        Width="120"
                        Height="40"
                        Margin="0,0,15,0"
                        Background="#27AE60"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="❌ Отмена"
                        Command="{Binding CancelCommand}"
                        Width="120"
                        Height="40"
                        Background="#E74C3C"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>